// assets/js/router.js

const routes = {
  '/':         'views/map.html',      // Page 1 : Carte interactive
  '/map':      'views/map.html',
  '/rules':    'views/rules.html',    // Page 2
  '/progress': 'views/progress.html', // Page 3
  '/questions':'views/questions.html',// Page 4
  '/rewards':  'views/rewards.html',  // Page 5
};

async function render() {
  const path = location.hash.replace('#','') || '/';
  const file = routes[path] || routes['/'];

  // Charge la vue
  const html = await fetch(file, { cache: 'no-cache' }).then(r => r.text());
  const app = document.getElementById('app');
  app.innerHTML = html;

  // Active le bouton courant
  document.querySelectorAll('.nav-btn').forEach(a => {
    a.classList.toggle('active', a.getAttribute('href') === `#${path}`);
  });

  // UX / Accessibilité
  const titles = { '/':'Carte', '/map':'Carte', '/rules':'Règles', '/progress':'Suivi', '/questions':'Questions', '/rewards':'Bilan' };
  document.title = `Serious Game — ${titles[path] || 'Carte'}`;
  app.setAttribute('tabindex','-1'); app.focus(); window.scrollTo(0,0);

  // Hooks d’init par page
  if (path === '/map' || path === '/') window.initMapPage?.();
  if (path === '/rules') window.initRulesPage?.();
  if (path === '/progress') window.initProgressPage?.();
  if (path === '/questions') window.initQuestionsPage?.();
  if (path === '/rewards') window.initRewardsPage?.();

  // Synchronise l'affichage du score si présent
  if (document.getElementById('totalScore')) {
    document.getElementById('totalScore').textContent = window.__score ?? 0;
  }
}

addEventListener('hashchange', render);
addEventListener('load', render);

